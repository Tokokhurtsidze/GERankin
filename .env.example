# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/startup-clash-ge

# NextAuth / Auth.js
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google account emails promoted to role "admin" on next sign-in.
# This is the only way to create an admin — there is no seed script.
ADMIN_EMAILS=

# Upstash Redis (not currently wired up anywhere — lib/redis/client.ts exists but is unused)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron auth (protects /api/cron/sweep — Vercel sends this automatically)
CRON_SECRET=

# Resend (transactional email — signup, registration, tournament/round/match/champion notices)
# Get an API key at resend.com/api-keys. EMAIL_FROM must be onboarding@resend.dev
# in dev/sandbox, or an address on a domain you've verified with Resend in production.
RESEND_API_KEY=
EMAIL_FROM=

# OpenRouter (AI concierge chatbot)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Cloudflare Turnstile (anti-bot voting)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Microlink (screenshot fallback for blocked iframes)
MICROLINK_API_KEY=

# Public site URL (used for OpenRouter referer header)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console site verification. Create a property at
# search.google.com/search-console, choose the "HTML tag" verification method,
# and paste just the content="..." value here (not the whole <meta> tag).
GOOGLE_SITE_VERIFICATION=
